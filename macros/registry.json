{
  "schema": "macrix.macro-registry/v1",
  "macroRoot": "macros",
  "notes": [
    "Macro sources live in this repository under macros/<dir> (migrated from the",
    "original checkout github.com/ketandholakia/Vittix-CDR-Macro, MIT).",
    "Each entry is a separate CorelDRAW VBA project with its own .gms file.",
    "They are NOT modules of the Macrix project: several module names collide across",
    "macros (modSettings, modUnits, mdlFormBuilder), so they must stay separate projects.",
    "'entryPoints' are 'Module.Procedure' names callable from CorelDRAW.",
    "'project' must match the Global Macro Project name saved inside CorelDRAW exactly."
  ],
  "macros": [
    {
      "id": "select-same",
      "display": "Macrix Select Same",
      "project": "MacrixSelectSame",
      "importForms": true,
      "dir": "MacrixSelectSame",
      "entryPoints": [ "mdlMain.SelectSimilarObjects" ],
      "stability": "beta",
      "status": "active"
    },
    {
      "id": "bleed",
      "display": "Macrix Bleed",
      "project": "macrixBleed",
      "importForms": true,
      "dir": "macrixBleed",
      "entryPoints": [ "Bleeds.Start" ],
      "stability": "beta",
      "status": "active"
    },
    {
      "id": "dimension-tools",
      "display": "Macrix Dimension Tools",
      "project": "MacrixTools",
      "importForms": false,
      "dir": "macrixTools",
      "entryPoints": [ "modMain.MacrixDimension", "modMain.MacrixTools_Create" ],
      "stability": "beta",
      "status": "active"
    },
    {
      "id": "imposition",
      "display": "Macrix Imposition",
      "project": "macrixImposition",
      "importForms": false,
      "dir": "macrixImposition",
      "entryPoints": [ "modImposition.RunImposition" ],
      "stability": "experimental",
      "status": "active"
    }
  ]
}
